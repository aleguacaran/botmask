# botmask configuration file (example - copy to botmask.toml for customization)
# This file is NOT tracked by git (see .gitignore)

# Browser executable path
executable = "/usr/bin/brave-browser"

# Directory for user data (profile, cookies, cache)
user_data_dir = "/app/browser_data"

# Run browser in headless mode (no GUI)
headless = false

# Browser locale/language
locale = "es-VE"

# Timezone string
timezone = "America/Caracas"

# Geolocation coordinates (decimal degrees)
latitude = 10.4806
longitude = -66.9036

# Navigation timeout (seconds)
navigation_timeout = 30

# Implicit wait (seconds)
implicit_wait = 10

# Human-like delay between actions (seconds)
human_delay_min = 3.0
human_delay_max = 8.0

# Additional Chromium/Brave arguments (list)
# Default anti-detection args (always included unless overridden):
# NOTE: --ozone-platform is auto-detected from WAYLAND_DISPLAY env var
#       (wayland if set, x11 otherwise). Override here only if needed.
args = [
    "--disable-blink-features=AutomationControlled",
    "--disable-dev-shm-usage",
    "--no-sandbox",
    "--disable-setuid-sandbox",
    "--disable-infobars",
    "--no-first-run",
    "--no-default-browser-check",
    "--password-store=basic",
    "--use-mock-keychain",
    "--disable-features=IsolateOrigins,site-per-process",
    "--disable-ipc-flooding-protection",
    "--disable-renderer-backgrounding",
    "--disable-backgrounding-occluded-windows",
    "--disable-background-timer-throttling",
    "--window-size=1920,1080",
]