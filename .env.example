# Browser paths
BROWSER_USER_DATA_DIR=/app/browser_data
BROWSER_HEADLESS=false
BROWSER_EXECUTABLE_PATH=/usr/bin/brave-browser
BROWSER_ARGS="--disable-blink-features=AutomationControlled --disable-dev-shm-usage --no-sandbox"

# Display
DISPLAY=:0
WAYLAND_DISPLAY=wayland-0
XDG_RUNTIME_DIR=/tmp

# Profile & geolocation
BROWSER_LOCALE=es-VE
BROWSER_TIMEZONE=America/Caracas
# BROWSER_LATITUDE=10.4806
# BROWSER_LONGITUDE=-66.9036

# Timeouts & delays
BROWSER_NAVIGATION_TIMEOUT=30
BROWSER_IMPLICIT_WAIT=10
HUMAN_DELAY_MIN=2.0
HUMAN_DELAY_MAX=8.0

# Server mode
VIRTUAL_DISPLAY=false
